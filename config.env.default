CONFIG_DIR="$HOME/.config/smb-mounter"
CONFIG_FILE="$CONFIG_DIR/config.env"
CREDS_FILE="$CONFIG_DIR/credentials"
LEDGER_FILE="$CONFIG_DIR/ledger.log"
FSTAB_BACKUP="/etc/fstab.smb-mounter.bak"
FSTAB_MARKER="# smb-mounter-managed"

HOST="nas.local"
SHARE_PATH="share/folder"
MOUNT_POINT="/mnt/smb-share"
HOME_LINK="$HOME/Documents/SMB-Share"
SMB_USER="smbuser"
SMB_DOMAIN="WORKGROUP"
MOUNT_UID="$(id -u)"
MOUNT_GID="$(id -g)"
MAX_RETRIES="3"
